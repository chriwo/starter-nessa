#!/usr/bin/env bash

## Description: Run Playwright + axe navigation E2E tests against the running site
## Usage: test-e2e [playwright args]
## Example: "ddev test-e2e", "ddev test-e2e --project=chromium", "ddev test-e2e --ui"
## ExecRaw: false

# Runs on the host (Playwright drives real browsers there). Requires Node.js on
# the host. Tests target the running DDEV site; override with E2E_BASE_URL.

set -eu

cd "${DDEV_APPROOT}/Resources/Private/frontendSrc"

if [ ! -d "node_modules/@playwright/test" ]; then
  echo "Installing frontend dependencies (host)..."
  npm install
fi

echo "Ensuring Playwright browsers are installed (host)..."
npx playwright install >/dev/null

export E2E_BASE_URL="${E2E_BASE_URL:-${DDEV_PRIMARY_URL:-https://theme-nessa.ddev.site}}"
echo "Running navigation E2E tests against ${E2E_BASE_URL}"
npx playwright test "$@"
