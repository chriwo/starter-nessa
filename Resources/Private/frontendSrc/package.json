{
	"name": "starter-nessa-starterkit",
	"version": "5.0.0",
	"description": "StarterNessa is a modern template theme",
	"main": "app.js",
	"author": "StarterTeam",
	"license": "private",
	"private": true,
	"scripts": {
		"start": "npm run dev",
		"dev": "vite build --watch --mode development",
		"build": "vite build",
		"lint": "npm run lint:js && npm run lint:scss",
		"lint:js": "eslint . --fix-dry-run && echo \"ESLint: Keine Probleme gefunden\"",
		"lint:scss": "stylelint \"./src/**/*.scss\" --config .stylelintrc.yml && echo \"Stylelint: Keine Probleme gefunden\"",
		"lint:fix:js": "eslint . --fix",
		"lint:fix:scss": "stylelint \"./src/**/*.scss\" --fix --config .stylelintrc.yml",
		"test": "echo \"No test specified\" && exit 0"
	},
	"dependencies": {
		"animate.css": "^4.1.1",
		"bootstrap": "^5.3.3",
		"isotope-layout": "^3.0.6",
		"jquery": "^3.4.1",
		"jquery.easing": "^1.4.1",
		"picturefill": "^3.0.2",
		"poly-fluid-sizing": "^1.1.0",
		"@popperjs/core": "^2.11.8",
		"smartmenus": "^1.1.0",
		"venobox": "^1.9.1"
	},
	"devDependencies": {
		"@rollup/plugin-inject": "^5.0.5",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"globals": "^17.3.0",
		"postcss": "^8.4.7",
		"prettier": "^3.8.1",
		"sass": "^1.49.8",
		"stylelint": "^17.3.0",
		"stylelint-config-idiomatic-css": "^1.1.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-order": "^7.0.1",
		"vite": "^6.1.0",
		"vite-plugin-static-copy": "^2.1.0"
	},
	"engines": {
		"node": ">=20 <23",
		"npm": ">=10"
	},
	"repository": {
		"type": "git",
		"url": "https://gitlab.com/starterteam/team/starter-nessa-starterkit.git"
	},
	"keywords": [
		"frontend",
		"toolkit"
	],
	"bugs": {
		"url": "https://gitlab.com/starterteam/team/base/-/issues"
	}
}
