mod.web_layout.BackendLayouts {
  DefaultLayout {
    title = LLL:EXT:starter_nessa/Resources/Private/Language/locallang_be.xlf:backend_layout.default_layout.title
    config {
      backend_layout {
        colCount = 12
        rowCount = 4
        rows {
          1 {
            columns {
              1 {
                name = LLL:EXT:starter_nessa/Resources/Private/Language/locallang_be.xlf:backend_layout.row.hero
                colPos = 1
                colspan = 12
                maxitems = 1
                allowed {
                  CType = nessa_hero,nessa_image_text,nessa_banner
                }
              }
            }
          }

          2 {
            columns {
              1 {
                name = LLL:EXT:starter_nessa/Resources/Private/Language/locallang_be.xlf:backend_layout.row.content
                colPos = 0
                colspan = 12
                disallowed {
                  CType = nessa_hero
                }
              }
            }
          }

          3 {
            columns {
              1 {
                name = LLL:EXT:starter_nessa/Resources/Private/Language/locallang_be.xlf:backend_layout.column.footer1
                colPos = 10
                colspan = 4
                disallowed {
                  CType = nessa_hero,nessa_footer
                }
              }
              2 {
                name = LLL:EXT:starter_nessa/Resources/Private/Language/locallang_be.xlf:backend_layout.column.footer2
                colPos = 11
                colspan = 4
                disallowed {
                  CType = nessa_hero,nessa_footer
                }
              }
              3 {
                name = LLL:EXT:starter_nessa/Resources/Private/Language/locallang_be.xlf:backend_layout.column.footer3
                colPos = 12
                colspan = 4
                disallowed {
                  CType = nessa_hero,nessa_footer
                }
              }
            }
          }

          4 {
            columns {
              1 {
                name = LLL:EXT:starter_nessa/Resources/Private/Language/locallang_be.xlf:backend_layout.row.footer
                colPos = 2
                colspan = 12
                maxitems = 1
                allowed {
                  CType = nessa_footer
                }
              }
            }
          }
        }
      }
    }
  }
}
