tt_content.nessa_team =< lib.contentElement
tt_content.nessa_team {
  templateName = NessaTeam

  dataProcessing {
    10 = StarterTeam\StarterNessa\DataProcessing\TeamMembersProcessor
    10 {
      fieldName = nessa_team_member_element
      as = teamMembers
    }
  }

  settings {
    media {
      width = 310c
      height = 310c
      cropVariant = default
    }
  }
}
