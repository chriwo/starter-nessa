lib.iconSprite = COA
lib.iconSprite {
    # Slot 10: Bootstrap Icons + Custom SVG Sprite from starter-nessa
    10 = TEXT
    10 {
        value = { path: EXT:starter_nessa/Resources/Public/Frontend/icons.svg }
        wrap = <div aria-hidden="true" style="display:none">|</div>
        insertData = 1
    }

    # Slots 20, 30, ... are reserved for customer extension sprites (empty by default)
}
