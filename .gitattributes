# Enforce checkout with linux lf consistent over all plattforms
.htaccess text eol=lf
*.cfg text eol=lf
*.css text eol=lf
*.dist text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.php text eol=lf
*.properties text eol=lf
*.rst text eol=lf
*.scss text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.svg text eol=lf
*.tpl text eol=lf
*.tsconfig text eol=lf
*.typoscript text eol=lf
*.txt text eol=lf
*.xlf text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# folders
/.build export-ignore
/.ddev export-ignore
/.github export-ignore
/.project export-ignore
/Resources/Private/frontendSrc export-ignore
/Tests/ export-ignore

# files
.editorconfig                  export-ignore
.env                           export-ignore
.gitattributes                 export-ignore
.gitignore                     export-ignore

.project/data/db.sql.gz filter=lfs diff=lfs merge=lfs -text
